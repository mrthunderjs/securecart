<div class="auth-card mx-auto"><h1 class="h3">Reset your password</h1><p class="text-muted">Enter your email and we will send reset instructions.</p><% if(sent){ %><div class="alert alert-info">If an account exists for that email, reset instructions have been sent.</div><% } %><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control mb-3" type="email" name="email" required><button class="btn btn-info w-100">Send instructions</button></form></div>
