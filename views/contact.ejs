<div class="auth-card mx-auto"><h1>Contact us</h1><p class="text-muted">Our team usually replies within one business day.</p><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control mb-3" name="name" placeholder="Name" required><input class="form-control mb-3" type="email" name="email" placeholder="Email" required><input class="form-control mb-3" name="subject" placeholder="Subject" required><textarea class="form-control mb-3" name="message" rows="5" placeholder="How can we help?" required></textarea><button class="btn btn-info">Send message</button></form></div>
