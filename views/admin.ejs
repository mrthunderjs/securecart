<h1>Admin dashboard</h1><div class="row g-3"><% [['users','Users','bi-people'],['products','Products','bi-box'],['orders','Orders','bi-receipt'],['revenue','Revenue','bi-cash-stack']].forEach(s=>{ %><div class="col-sm-6 col-lg-3"><div class="stat-card"><i class="bi <%= s[2] %>"></i><small><%= s[1] %></small><strong><%= s[0]==='revenue'?'$'+Number(stats[s[0]]).toFixed(2):stats[s[0]] %></strong></div></div><% }) %></div><a class="btn btn-info mt-4" href="/admin/products">Manage products</a>
