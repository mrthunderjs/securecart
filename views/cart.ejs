<h1>Your cart</h1><% if(!items.length){ %><div class="text-center py-5"><i class="bi bi-cart display-1 text-muted"></i><h3>Your cart is empty</h3><a href="/" class="btn btn-info">Start shopping</a></div><% }else{ %><div class="table-responsive"><table class="table align-middle"><% let total=0; items.forEach(i=>{total+=i.price*i.quantity;%><tr><td><img src="<%= i.image %>" width="80" class="rounded" alt=""></td><td><%= i.name %></td><td>$<%= Number(i.price).toFixed(2) %></td><td><form method="post" action="/cart/update/<%= i.id %>" class="d-flex"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" style="width:80px" type="number" min="0" max="99" name="quantity" value="<%= i.quantity %>"><button class="btn btn-outline-secondary ms-2">Update</button></form></td><td>$<%= (i.price*i.quantity).toFixed(2) %></td><td><form method="post" action="/cart/remove/<%= i.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link text-danger"><i class="bi bi-trash"></i></button></form></td></tr><% }) %></table></div><div class="text-end"><h3>Total: $<%= total.toFixed(2) %></h3><a href="/checkout" class="btn btn-info">Checkout</a></div><% } %>
