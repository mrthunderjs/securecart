<div class="row g-5"><div class="col-md-6"><img src="<%= product.image %>" class="img-fluid rounded-4 shadow-sm" alt="<%= product.name %>"></div><div class="col-md-6"><span class="text-muted"><%= product.category_name %></span><h1><%= product.name %></h1><div class="text-warning mb-3"><i class="bi bi-star-fill"></i> <%= product.rating %> / 5</div><p class="lead"><%= product.description %></p><h2 class="mb-3">$<%= Number(product.price).toFixed(2) %></h2><p class="text-success"><i class="bi bi-check-circle"></i> <%= product.stock %> in stock</p><form method="post" action="/cart/add/<%= product.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-info btn-lg" <%= product.stock<1?'disabled':'' %>><i class="bi bi-cart-plus"></i> Add to cart</button></form></div></div><hr class="my-5"><h3>Related products</h3><div class="row g-3"><% related.forEach(p=>{ %><div class="col-6 col-md-3"><a href="/products/<%= p.slug %>"><img src="<%= p.image %>" class="img-fluid rounded" alt="<%= p.name %>"><p class="mt-2"><%= p.name %></p></a></div><% }) %></div>
