<h1>My dashboard</h1><div class="row g-4"><div class="col-md-5"><div class="card card-body"><h4>Profile</h4><form method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control mb-2" name="name" value="<%= user.name %>" required><input class="form-control mb-2" value="<%= user.email %>" disabled><textarea class="form-control mb-2" name="address" placeholder="Shipping address"><%= user.address||'' %></textarea><button class="btn btn-info">Save profile</button></form></div></div><div class="col-md-7"><h4>Order history</h4><table class="table"><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= new Date(o.created_at).toLocaleDateString() %></td><td>$<%= o.total.toFixed(2) %></td><td><span class="badge bg-secondary"><%= o.status %></span></td></tr><% }) %></table></div></div>
