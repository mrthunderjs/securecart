<h1>Checkout</h1><div class="row"><div class="col-md-7"><form method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Shipping address</label><textarea class="form-control mb-3" name="address" rows="4" required><%= user.address %></textarea><button class="btn btn-info btn-lg">Place order securely</button></form></div><div class="col-md-5"><div class="card card-body"><h4>Order summary</h4><% let total=0;items.forEach(i=>{total+=i.price*i.quantity;%><div class="d-flex justify-content-between"><span><%= i.name %> × <%= i.quantity %></span><span>$<%= (i.price*i.quantity).toFixed(2) %></span></div><% }) %><hr><strong class="d-flex justify-content-between"><span>Total</span><span>$<%= total.toFixed(2) %></span></strong></div></div></div>
