<section class="hero rounded-4 p-5 mb-5 text-white"><div class="col-lg-7"><span class="badge bg-info mb-3">SECURE SHOPPING, SIMPLIFIED</span><h1 class="display-4 fw-bold">Everything you need.<br><span class="text-info">Delivered securely.</span></h1><p class="lead">Discover quality products, transparent prices, and a checkout built with your privacy in mind.</p><a href="#products" class="btn btn-info btn-lg">Explore collection <i class="bi bi-arrow-right"></i></a></div></section>
<div class="d-flex justify-content-between align-items-center mb-3" id="products"><h2 class="h3">Shop the collection</h2><div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Categories</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="/">All products</a></li><% categories.forEach(c=>{ %><li><a class="dropdown-item" href="/categories/<%= c.slug %>"><%= c.name %></a></li><% }) %></ul></div></div><div class="row g-4"><% products.forEach(p=>{ %><div class="col-6 col-md-4 col-lg-3"><div class="card product-card h-100"><img src="<%= p.image %>" class="card-img-top" alt="<%= p.name %>" loading="lazy"><div class="card-body d-flex flex-column"><small class="text-muted"><%= p.category_name %></small><h5 class="card-title"><a href="/products/<%= p.slug %>"><%= p.name %></a></h5><div class="text-warning mb-2"><i class="bi bi-star-fill"></i> <%= p.rating %></div><div class="mt-auto d-flex justify-content-between align-items-center"><strong>$<%= Number(p.price).toFixed(2) %></strong><form method="post" action="/cart/add/<%= p.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-info" <%= p.stock<1?'disabled':'' %>><i class="bi bi-cart-plus"></i></button></form></div></div></div></div><% }) %></div><% if(pages>1){ %><nav class="mt-4"><ul class="pagination justify-content-center"><% for(let i=1;i<=pages;i++){ %><li class="page-item <%= i===page?'active':'' %>"><a class="page-link" href="/?page=<%= i %>&q=<%= encodeURIComponent(q) %>"><%= i %></a></li><% } %></ul></nav><% } %>
